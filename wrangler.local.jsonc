{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vocal-studio-local",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist/cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "STUDIO", "class_name": "StudioState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudioState"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vocal-studio-media" }],
  "vars": {
    "ENVIRONMENT": "local-test",
    "STUDIO_NAMESPACE": "vocal-studio",
    "ACCESS_TEAM_DOMAIN": "local.invalid",
    "ACCESS_AUD": "local-audience",
    "ACCESS_ALLOWED_EMAILS": "qa@local.invalid",
    "LOCAL_TEST_TOKEN": "vocal-studio-local-test",
    "DEPLOYMENT_ENABLED": "false"
  }
}
