{
  "rewrites": [
    { "source": "/vocal-studio.html", "destination": "/index.html" },
    { "source": "/vocal-studi.html", "destination": "/index.html" },
    { "source": "/gjc-session-:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
