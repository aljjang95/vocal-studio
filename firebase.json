{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "**/.*",
      ".gjc/**",
      "**/node_modules/**",
      "tmp/**",
      "scripts/**",
      "docs/**",
      "js/**",
      "gjc-session-*.html",
      "vocal-studio.html",
      "vocal-studi.html"
    ],
    "rewrites": [
      { "source": "/vocal-studio.html", "destination": "/index.html" },
      { "source": "/vocal-studi.html", "destination": "/index.html" },
      { "source": "/gjc-session-**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
